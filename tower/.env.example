# Tower environment, by example. Copy to `.env` and edit.
#
# `.env` is gitignored and this file is not, deliberately: the VALUES are a
# property of one machine and the LIST is a property of the project. Until
# 2026-08-29 only the list of World Builder variables was written down
# anywhere, and the Object Memory ones lived in whatever a person had last
# typed into their shell -- which is how a physical run came to require
#
#     $env:TOWER_OBSERVATION_VERIFIER="owlv2"
#     $env:TOWER_OBSERVATION_VERIFIER_DEVICE="cuda"
#
# before every launch.
#
# `scripts/start_tower.ps1` hands this file to uvicorn with `--env-file`,
# which loads it in `Config.__init__` -- before the app is imported -- so
# these reach `get_settings()`. It also prints every value below, with where
# it came from, before it binds a port.
#
# EVERY VARIABLE HERE IS OPTIONAL. The defaults in `tower/config.py` are the
# intended configuration; this file exists to override them on a host that
# needs something else, and to make the list discoverable.


# --- Recording -------------------------------------------------------------

# Where captured frames are written. UNSET MEANS NO FRAMES ARE EVER RECORDED,
# and it is also the one thing Object Memory imagery needs: without it the
# imagery routes answer 503 and a memory can be written but never shown.
TOWER_CAPTURE_ROOT=data

# World Builder's tree. Unset means iOS shows World Builder as unsupported.
TOWER_WORLD_ROOT=data/world_builder


# --- Object Memory ---------------------------------------------------------

# Off switch for the whole cartridge. `false` makes /object-memory/* answer
# 404 and leaves Start on the phone with nothing to start.
# TOWER_OBSERVATION_ENABLED=true

# One path for the producer AND the read routes. The default is
# <tower>/data/object_memory and needs no setting.
# TOWER_OBSERVATION_ROOT=data/object_memory

# `owlv2` is the default and takes what this Tower records from two classes
# to fourteen (see docs/contracts/OBJECT-MEMORY.md section 11). It loads
# google/owlv2-base-patch16-ensemble -- Apache-2.0, ~600 MB, fetched once and
# cached under ~/.cache/huggingface. A host that cannot load it says so and
# records the two anyway; it does not fail.
#
# Set this to `none` to record only `laptop` and `cell phone`, which are the
# two classes the detector alone was measured to be trustworthy on.
# TOWER_OBSERVATION_VERIFIER=owlv2

# `auto`, `cpu` or `cuda`. `auto` downgrades to CPU where there is no GPU and
# the producer prints the device it actually got on its first line. `cuda`
# also downgrades rather than killing a walk, and says so at WARNING.
#
# The verifier measured 126 ms a crop on this GPU against 2,473 ms on this
# CPU -- a factor of nineteen -- for 620 MB of VRAM. The detector measured
# 69.3 ms/frame on CPU against 100.4 on CUDA, so it is the stage that should
# stay off the contended device if a host is short of one.
# TOWER_OBSERVATION_VERIFIER_DEVICE=auto
# TOWER_OBSERVATION_DEVICE=auto

# How long an observation is kept, and the window the store manifest records
# at first append. A reader may narrow this and nothing can widen it.
# TOWER_OBSERVATION_RETENTION_DAYS=30


# --- Privacy ---------------------------------------------------------------

# The YuNet weights, for the face display filter. The default resolves
# `models/face_detection_yunet_2023mar.onnx` RELATIVE TO THE PROCESS CWD --
# which is why start_tower.ps1 sets the working directory, and why launching
# uvicorn from somewhere else silently disables World Builder's redaction.
#
# Object Memory does not fail silently on this: with no weights it serves NO
# picture at all rather than an unfiltered first-person frame.
# TOWER_FACE_REDACTION_MODEL=models/face_detection_yunet_2023mar.onnx


# --- Other cartridges ------------------------------------------------------

# TOWER_DEV_MODE=true
# TOWER_CV_EXPERIMENT=baseline
# TOWER_CV_DEVICE=auto

# Read into Settings and then read back by nothing. Setting them binds no
# port; `start_tower.ps1 -BindHost/-Port` is what decides that.
# TOWER_HOST=
# TOWER_PORT=
